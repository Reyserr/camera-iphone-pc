<Window x:Class="CameraPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LynxCam"
        Width="1360" Height="880" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/LynxCam.ico"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════ Barre du haut : nom et connexion ═════════ -->
        <Border Grid.Row="0" Background="{StaticResource BarBrush}" Padding="18,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/LynxCam.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LynxCam" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Ton iPhone comme webcam" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Déconnecté" Margin="8,0,18,0" VerticalAlignment="Center"
                               MaxWidth="380" TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="ModeBox" Width="150" VerticalAlignment="Center" SelectionChanged="ModeBox_SelectionChanged">
                        <ComboBoxItem Content="Wi-Fi" Tag="wifi" />
                        <ComboBoxItem Content="Câble USB" Tag="usb" />
                    </ComboBox>
                    <TextBox x:Name="HostBox" Width="170" Margin="8,0,0,0" VerticalAlignment="Center"
                             ToolTip="Adresse IP affichée sur l'iPhone" KeyDown="ConnectionBox_KeyDown" />
                    <Button x:Name="ConnectButton" Content="Se connecter" MinWidth="140" Margin="8,0,0,0"
                            VerticalAlignment="Center" Click="ConnectButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═════════ Contenu ═════════ -->
        <Grid Grid.Row="1" Margin="18,14,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- Aperçu et actions -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="10" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                        <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" FontSize="15" Foreground="{StaticResource MutedBrush}"
                                   Text="Aucune image&#x0a;Ouvre LynxCam sur l'iPhone puis clique sur « Se connecter »" />

                        <Border x:Name="RecBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                                Background="#CC000000" CornerRadius="12" Padding="12,5" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecText" Text="REC 00:00" Foreground="White" FontWeight="Bold" Margin="7,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="OverlayBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                                Background="#99000000" CornerRadius="8" Padding="10,5" Visibility="Collapsed">
                            <TextBlock x:Name="OverlayText" Foreground="White" FontFamily="Consolas" FontSize="12" />
                        </Border>
                    </Grid>
                </Border>

                <WrapPanel x:Name="ActionBar" Grid.Row="1" HorizontalAlignment="Center" Margin="0,12,0,0" IsEnabled="False">
                    <Button Content="Changer de caméra" Margin="4" Padding="14,8" Click="SwitchCamera_Click" />
                    <ToggleButton x:Name="TorchToggle" Content="Lampe" Margin="4" Padding="14,8" Click="TorchToggle_Click" />
                    <ToggleButton x:Name="MicToggle" Content="Micro" Margin="4" Padding="14,8" Click="MicToggle_Click" />
                    <Button Content="Photo" Margin="4" Padding="14,8" Click="Photo_Click"
                            ToolTip="Photo dans la galerie de l'iPhone et dans Images\LynxCam" />
                    <ToggleButton x:Name="RecordToggle" Margin="4" Padding="14,8" Click="RecordToggle_Click"
                                  ToolTip="Vidéo enregistrée dans la galerie de l'iPhone">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RecordLabel" Text="Enregistrer" Margin="7,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Content="Capture PC" Margin="4" Padding="14,8" Click="Snapshot_Click"
                            ToolTip="Enregistre l'image affichée dans Images\LynxCam" />
                </WrapPanel>
            </Grid>

            <!-- Réglages -->
            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <!-- Webcam virtuelle -->
                    <Expander Header="Webcam virtuelle (OBS, Discord, Zoom…)" IsExpanded="True" Margin="0,0,0,8"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="4,4,4,8">
                            <TextBlock x:Name="VirtualCamStatus" Text="—" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ToggleButton x:Name="WebcamToggle" Content="Activer la webcam" Padding="12,6" Click="WebcamToggle_Click" />
                                <Button x:Name="InstallCamButton" Content="Installer" Margin="8,0,0,0" Padding="12,6" Click="InstallCam_Click" />
                                <Button x:Name="UninstallCamButton" Content="Désinstaller" Margin="8,0,0,0" Padding="12,6" Click="UninstallCam_Click" />
                            </StackPanel>
                            <TextBlock Text="Taille de la webcam" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="VirtualCamResolutionBox" SelectionChanged="VirtualCamResolutionBox_SelectionChanged">
                                <ComboBoxItem Content="1280 × 720" Tag="720p" />
                                <ComboBoxItem Content="1920 × 1080" Tag="1080p" />
                            </ComboBox>
                            <CheckBox x:Name="VirtualCamAutoBox" Content="Activer la webcam au démarrage" Margin="0,10,0,0"
                                      Click="VirtualCamAutoBox_Click" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Dans OBS : Sources › + › Périphérique de capture vidéo › LynxCam. Dans Discord : Paramètres › Voix et vidéo › Caméra › LynxCam." />
                        </StackPanel>
                    </Expander>

                    <!-- Vidéo -->
                    <Expander x:Name="VideoSection" Header="Vidéo" IsExpanded="True" Margin="0,0,0,8" IsEnabled="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock Text="Objectif" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CameraBox" SelectionChanged="CameraBox_SelectionChanged">
                                <ComboBoxItem Content="Arrière" Tag="back" />
                                <ComboBoxItem Content="Ultra grand-angle" Tag="ultrawide" />
                                <ComboBoxItem Content="Avant (selfie)" Tag="front" />
                            </ComboBox>

                            <TextBlock Text="Résolution" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionBox_SelectionChanged">
                                <ComboBoxItem Content="1280 × 720 (HD)" Tag="720p" />
                                <ComboBoxItem Content="1920 × 1080 (Full HD)" Tag="1080p" />
                            </ComboBox>

                            <TextBlock Text="Images par seconde" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FpsBox" SelectionChanged="FpsBox_SelectionChanged">
                                <ComboBoxItem Content="15 img/s" Tag="15" />
                                <ComboBoxItem Content="24 img/s (cinéma)" Tag="24" />
                                <ComboBoxItem Content="30 img/s" Tag="30" />
                                <ComboBoxItem Content="60 img/s (fluide)" Tag="60" />
                            </ComboBox>

                            <TextBlock x:Name="QualityLabel" Text="Qualité : 70 %" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="QualitySlider" Minimum="30" Maximum="95" Value="70" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged" />

                            <TextBlock x:Name="ZoomLabel" Text="Zoom : ×1,0" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" />

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="60 img/s en 1080p demande beaucoup de débit : préfère le câble USB." />
                        </StackPanel>
                    </Expander>

                    <!-- Arrière-plan -->
                    <Expander x:Name="BackgroundSection" Header="Arrière-plan" IsExpanded="True" Margin="0,0,0,8" IsEnabled="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock Text="Effet" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="BackgroundBox" SelectionChanged="BackgroundBox_SelectionChanged">
                                <ComboBoxItem Content="Aucun" Tag="none" />
                                <ComboBoxItem Content="Flou" Tag="blur" />
                                <ComboBoxItem Content="Thème" Tag="theme" />
                                <ComboBoxItem Content="Ma photo" Tag="image" />
                            </ComboBox>

                            <StackPanel x:Name="BlurPanel">
                                <TextBlock x:Name="BlurLabel" Text="Force du flou : 50" Style="{StaticResource FieldLabel}" />
                                <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" Value="50" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="BlurSlider_ValueChanged" />
                            </StackPanel>

                            <StackPanel x:Name="ThemePanel">
                                <TextBlock Text="Thème" Style="{StaticResource FieldLabel}" />
                                <ListBox x:Name="ThemeList" SelectionChanged="ThemeList_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Fond vert : dans OBS, ajoute le filtre « Incrustation chromatique » sur la source LynxCam." />
                            </StackPanel>

                            <StackPanel x:Name="PhotoPanel">
                                <Button Content="Choisir une photo…" Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Left"
                                        Click="ChoosePhoto_Click" />
                                <TextBlock x:Name="PhotoNameText" Text="Aucune photo choisie" Style="{StaticResource Hint}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="La puce de l'iPhone détoure la personne, comme le mode Portrait." />
                        </StackPanel>
                    </Expander>

                    <!-- Image -->
                    <Expander x:Name="ImageSection" Header="Image" Margin="0,0,0,8" IsEnabled="False"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock x:Name="ExposureLabel" Text="Exposition : 0,0" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="ExposureSlider" Minimum="-3" Maximum="3" Value="0" TickFrequency="0.1"
                                    IsSnapToTickEnabled="True" ValueChanged="ExposureSlider_ValueChanged" />

                            <CheckBox x:Name="FocusAutoBox" Content="Mise au point automatique" IsChecked="True" Margin="0,12,0,0"
                                      Click="FocusAutoBox_Click" />
                            <TextBlock Text="Mise au point (près ← → loin)" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="FocusSlider" Minimum="0" Maximum="1" Value="0.5" TickFrequency="0.01"
                                    IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="FocusSlider_ValueChanged" />

                            <CheckBox x:Name="WhiteBalanceAutoBox" Content="Balance des blancs automatique" IsChecked="True" Margin="0,12,0,0"
                                      Click="WhiteBalanceAutoBox_Click" />
                            <TextBlock x:Name="KelvinLabel" Text="Température : 5500 K" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="KelvinSlider" Minimum="2500" Maximum="9000" Value="5500" TickFrequency="100"
                                    IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="KelvinSlider_ValueChanged" />

                            <TextBlock x:Name="BrightnessLabel" Text="Luminosité : 0" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" />
                            <TextBlock x:Name="ContrastLabel" Text="Contraste : 0" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" />
                            <TextBlock x:Name="SaturationLabel" Text="Saturation : 0" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="ColorSlider_ValueChanged" />

                            <CheckBox x:Name="MirrorBox" Content="Effet miroir" Margin="0,12,0,0" Click="MirrorBox_Click" />
                            <Button Content="Réinitialiser l'image" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Left"
                                    Click="ResetImage_Click" />
                        </StackPanel>
                    </Expander>

                    <!-- Son -->
                    <Expander Header="Son" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Margin="4,0,4,8">
                            <CheckBox x:Name="MicBox" Content="Micro de l'iPhone" Margin="0,8,0,0" Click="MicBox_Click" />
                            <TextBlock Text="Sortie du son sur le PC" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="AudioDeviceBox" DisplayMemberPath="Value" SelectionChanged="AudioDeviceBox_SelectionChanged" />
                            <TextBlock x:Name="VolumeLabel" Text="Volume : 100 %" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="VolumeSlider_ValueChanged" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="OBS : ajoute une source « Capture audio d'application » et choisis LynxCam. Discord : installe VB-Audio Virtual Cable, choisis « CABLE Input » ici, puis « CABLE Output » comme micro dans Discord." />
                        </StackPanel>
                    </Expander>

                    <!-- Infos -->
                    <Expander Header="Infos" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid Margin="4,4,4,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Appareil" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceText" Text="—" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="1" Text="Image" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResolutionText" Text="—" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="2" Text="Images/s" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FpsText" Text="—" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="3" Text="Latence" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LatencyText" Text="—" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="4" Text="Débit" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BitrateText" Text="—" Style="{StaticResource InfoValue}" />
                            <TextBlock Grid.Row="5" Text="Batterie" Style="{StaticResource InfoName}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BatteryText" Text="—" Style="{StaticResource InfoValue}" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═════════ Journal ═════════ -->
        <Expander Grid.Row="2" Header="Journal" Margin="18,0,18,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <ListBox x:Name="LogList" Height="150" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </Expander>
    </Grid>
</Window>
