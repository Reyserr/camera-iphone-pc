<Window x:Class="CameraPC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caméra iPhone → PC"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Connexion et infos -->
        <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Connexion Wi-Fi" Style="{StaticResource SectionTitle}" />

                <TextBlock Text="Adresse IP de l'iPhone" Style="{StaticResource Label}" />
                <TextBox x:Name="HostBox" KeyDown="ConnectionBox_KeyDown" />

                <TextBlock Text="Port" Style="{StaticResource Label}" />
                <TextBox x:Name="PortBox" Text="5050" KeyDown="ConnectionBox_KeyDown" />

                <Button x:Name="ConnectButton" Content="Se connecter" Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButton}" Click="ConnectButton_Click" />

                <TextBlock x:Name="StatusText" Text="Déconnecté" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />

                <TextBlock Text="Infos" Style="{StaticResource SectionTitle}" Margin="0,26,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Appareil" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="Image" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ResolutionText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" />
                    <TextBlock Grid.Row="2" Text="Images/s" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FpsText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" />
                    <TextBlock Grid.Row="3" Text="Latence" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LatencyText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" />
                    <TextBlock Grid.Row="4" Text="Débit" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BitrateText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" />
                    <TextBlock Grid.Row="5" Text="Batterie" Style="{StaticResource Label}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="BatteryText" Text="—" Style="{StaticResource Value}" Margin="0,8,0,3" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Aperçu -->
        <Border Grid.Column="1" Grid.Row="0" Background="Black" CornerRadius="8" Margin="12,0">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />
                <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                           Text="Aucune image&#x0a;Ouvre l'app sur l'iPhone puis clique sur « Se connecter »" />
            </Grid>
        </Border>

        <!-- Réglages caméra -->
        <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
            <StackPanel x:Name="CameraPanel">
                <TextBlock Text="Caméra de l'iPhone" Style="{StaticResource SectionTitle}" />

                <TextBlock Text="Objectif" Style="{StaticResource Label}" />
                <ComboBox x:Name="CameraBox" SelectionChanged="CameraBox_SelectionChanged">
                    <ComboBoxItem Content="Arrière" Tag="back" />
                    <ComboBoxItem Content="Ultra grand-angle" Tag="ultrawide" />
                    <ComboBoxItem Content="Avant" Tag="front" />
                </ComboBox>

                <TextBlock Text="Résolution" Style="{StaticResource Label}" />
                <ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionBox_SelectionChanged">
                    <ComboBoxItem Content="1280 × 720" Tag="720p" />
                    <ComboBoxItem Content="1920 × 1080" Tag="1080p" />
                </ComboBox>

                <TextBlock x:Name="QualityLabel" Text="Qualité JPEG : 70 %" Style="{StaticResource Label}" />
                <Slider x:Name="QualitySlider" Minimum="30" Maximum="95" Value="70"
                        TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged" />

                <TextBlock x:Name="ZoomLabel" Text="Zoom : ×1,0" Style="{StaticResource Label}" />
                <Slider x:Name="ZoomSlider" Minimum="1" Maximum="5" Value="1"
                        TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="ZoomSlider_ValueChanged" />

                <CheckBox x:Name="TorchBox" Content="Lampe torche" Margin="0,14,0,0"
                          Foreground="{StaticResource TextBrush}" Checked="TorchBox_Changed" Unchecked="TorchBox_Changed" />

                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Text="Les réglages s'appliquent à l'iPhone en direct. Plus la qualité est haute, plus le débit monte." />
            </StackPanel>
        </Border>

        <!-- Journal -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource PanelBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Journal" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
